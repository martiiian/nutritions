{
  "version": "1.0.0",
  "tasks": {
    "dev": "deno run --watch --allow-read --allow-env src/main.ts",
    "test": "deno test --allow-read --allow-write src/",
    "build": "deno compile --allow-read --allow-env --output dist/nutritions src/main.ts"
  },
  "fmt": {
    "semiColons": false,
    "singleQuote": true
  },
  "imports": {
    "@/": "./src/",
    "@cliffy/table": "jsr:@cliffy/table@^1.0.0",
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/fmt": "jsr:@std/fmt@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.16",
    "@std/path": "jsr:@std/path@^1.0.8"
  }
}
